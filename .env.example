# ================================================================
# DOBOT MAGICIAN SIMULATOR - MULTI-DEVICE REMOTE CONTROL CONFIG
# ================================================================

# Authentication JWT Secret (Generate a strong 32+ character random string for production)
AUTH_SECRET="dobot-magician-secret-key-2024-secure-jwt"
JWT_SECRET="dobot-magician-secret-key-2024-secure-jwt"

# User 1: Host Account (Laptop / Desktop 3D Simulator)
HOST_USERNAME="atharv"
HOST_PASSWORD="atharv123"

# User 2: Remote Controller Account (Smartphone Mobile Control Interface)
CONTROLLER_USERNAME="test"
CONTROLLER_PASSWORD="test123"

# Real-Time WebSocket Backend URL
# In local development: "http://localhost:3001" (or LAN IP e.g. "http://192.168.1.50:3001")
# In production on Render/Railway/Fly/VPS: "https://your-dobot-relay.onrender.com"
NEXT_PUBLIC_REALTIME_SERVER_URL="http://localhost:3002"

# Port for Real-Time Relay Server (default: 3002)
PORT=3002
